mach create $machine_name

# Compile from source (development mode - slower but allows live editing)
# For production mode (pre-built DLL), use initialize_peripherals.resc instead

include $ORIGIN/../external/renode-rp2040/emulation/externals/w25q16.cs

include $ORIGIN/../external/renode-rp2040/emulation/peripherals/memory/memory_alias.cs

include $ORIGIN/../external/renode-rp2040/emulation/peripherals/rp2040_peripheral_base.cs
EnsureTypeIsLoaded "Antmicro.Renode.Peripherals.RP2040PeripheralBase"
EnsureTypeIsLoaded "Antmicro.Renode.Peripherals.IRP2040Peripheral"


include $ORIGIN/../external/renode-rp2040/emulation/peripherals/clocks/rp2040_xosc.cs
EnsureTypeIsLoaded "Antmicro.Renode.Peripherals.Miscellaneous.RP2040XOSC"
include $ORIGIN/../external/renode-rp2040/emulation/peripherals/clocks/rp2040_rosc.cs
EnsureTypeIsLoaded "Antmicro.Renode.Peripherals.Miscellaneous.RP2040ROSC"
include $ORIGIN/../external/renode-rp2040/emulation/peripherals/clocks/rp2040_pll.cs
EnsureTypeIsLoaded "Antmicro.Renode.Peripherals.Miscellaneous.RP2040PLL"

include $ORIGIN/../external/renode-rp2040/emulation/peripherals/power/power.cs
include $ORIGIN/../external/renode-rp2040/emulation/peripherals/gpio/rp2040_gpio.cs
EnsureTypeIsLoaded "Antmicro.Renode.Peripherals.GPIOPort.RP2040GPIO"
include $ORIGIN/../external/renode-rp2040/emulation/peripherals/clocks/rp2040_clocks.cs
EnsureTypeIsLoaded "Antmicro.Renode.Peripherals.Miscellaneous.RP2040Clocks"
include $ORIGIN/../external/renode-rp2040/emulation/peripherals/timer/rp2040_timer.cs

include $ORIGIN/../external/renode-rp2040/emulation/peripherals/gpio/rp2040_pads.cs
EnsureTypeIsLoaded "Antmicro.Renode.Peripherals.GPIOPort.RP2040Pads"
include $ORIGIN/../external/renode-rp2040/emulation/peripherals/gpio/rp2040_qspi_pads.cs


include $ORIGIN/../external/renode-rp2040/emulation/peripherals/pio/rp2040_pio.cs
EnsureTypeIsLoaded "Antmicro.Renode.Peripherals.CPU.PioSimPathExtension"
emulation CreateSegmentDisplayTester "piosim_path"
piosim_path path $ORIGIN/../external/renode-rp2040/piosim


include $ORIGIN/../external/renode-rp2040/emulation/peripherals/spi/rp2040_spi.cs
EnsureTypeIsLoaded "Antmicro.Renode.Peripherals.SPI.PL022"
include $ORIGIN/../external/renode-rp2040/emulation/peripherals/spi/rp2040_xip_ssi.cs

include $ORIGIN/patches/rp2040_sio.cs

include $ORIGIN/../external/renode-rp2040/emulation/peripherals/adc/rp2040_adc.cs

include $ORIGIN/../external/renode-rp2040/emulation/peripherals/uart/rp2040_uart.cs

include $ORIGIN/../external/renode-rp2040/emulation/peripherals/dma/rpdma_engine.cs
EnsureTypeIsLoaded "Antmicro.Renode.Peripherals.DMA.RPDmaEngine"
include $ORIGIN/../external/renode-rp2040/emulation/peripherals/dma/rpdma.cs

include $ORIGIN/../external/renode-rp2040/emulation/peripherals/watchdog/rp2040_watchdog.cs

include $ORIGIN/../external/renode-rp2040/emulation/peripherals/i2c/rp2040_i2c.cs

include $ORIGIN/../external/renode-rp2040/emulation/externals/pcf8523.cs

include $ORIGIN/../external/renode-rp2040/emulation/externals/bmp280.cs

include $ORIGIN/../external/renode-rp2040/emulation/externals/i_segment_display.cs
EnsureTypeIsLoaded "Antmicro.Renode.Peripherals.Miscellaneous.ISegmentDisplay"

include $ORIGIN/../external/renode-rp2040/emulation/externals/segment_display.cs
EnsureTypeIsLoaded "Antmicro.Renode.Peripherals.Miscellaneous.SegmentDisplay"


include $ORIGIN/../external/renode-rp2040/emulation/peripherals/psm/rp2040_psm.cs
