/* DAQ drain (Phase 3's XCP task takes this over on the wire). */
static void rte_gen_daq_task(void *arg) {
    (void) arg;
    rte_gen_daq_frame_t frame;
    for (;;) {
        while (rte_daq_ring_pop(&s_daq, &frame)) {
            g_rte_gen_telemetry.daq_frames_drained++;
        }
        vTaskDelay(1);
    }
}

static void rte_gen_stats_task(void *arg) {
    (void) arg;
    uint32_t last_hb = 0;
    for (;;) {
        vTaskDelay(pdMS_TO_TICKS(1000));
        fault_inject_poll(); /* BLD-006/BLD-007 drill console */
        const uint32_t hb = g_rte_gen_telemetry.heartbeat;
        /* Benign cross-bank debug reads: 32-bit-or-smaller, torn-free. */
        printf("RTEGEN hb=%lu dhb=%lu exec_max=%lu ovr=%lu slf=%lu "
{% for group in slow_groups %}
               "{{ group.name }}=%lu "
{% endfor %}
               "daq=%lu daq_drain=%lu crit_max=%lu crit_n=%lu"
{% for d in debug_signals %}
               " {{ d.model }}_{{ d.port }}=%ld"
{% endfor %}
               "\n",
               (unsigned long) hb, (unsigned long) (hb - last_hb),
               (unsigned long) g_rte_gen_telemetry.exec_max_us,
               (unsigned long) g_rte_gen_telemetry.overrun_count,
               (unsigned long) g_rte_gen_telemetry.seqlock_fault_count,
{% for group in slow_groups %}
               (unsigned long) g_rte_gen_telemetry.{{ group.name }}_activations,
{% endfor %}
               (unsigned long) g_rte_gen_telemetry.daq_frames_pushed,
               (unsigned long) g_rte_gen_telemetry.daq_frames_drained,
               /* NFR-3 probe. Zero unless built -DPICODESK_NFR3_PROBE=1; read
                * crit_max together with crit_n, because max=0 with n=0 means
                * "not measured" and max=0 with n>0 means "below the 1 us clock
                * resolution". See target/rte/rte_port.h. */
               (unsigned long) rte_crit_max_us(),
               (unsigned long) rte_crit_samples()
{%- for d in debug_signals %},
               (long) s_store_{{ d.group }}.{{ d.model }}_{{ d.port }}{% if d.width > 1 %}[0]{% endif %}
{%- endfor %});
        last_hb = hb;
    }
}

void rte_gen_start(void) {
{% for group in slow_groups %}
    s_h_{{ group.name }} = NULL;
{% endfor %}

{% for group in slow_groups %}
    TaskHandle_t h_{{ group.name }} = xTaskCreateStatic(
        rte_gen_{{ group.name }}_task, "{{ group.name }}",
        RTE_GEN_TASK_STACK_WORDS, NULL, {{ priorities[group.name] }},
        s_stack_{{ group.name }}, &s_tcb_{{ group.name }});
    vTaskCoreAffinitySet(h_{{ group.name }}, RTE_GEN_CORE1_MASK);
{% endfor %}
    TaskHandle_t h_daq = xTaskCreateStatic(rte_gen_daq_task, "daq",
        RTE_GEN_TASK_STACK_WORDS, NULL, 2, s_stack_daq, &s_tcb_daq);
    vTaskCoreAffinitySet(h_daq, RTE_GEN_CORE1_MASK);
    TaskHandle_t h_stats = xTaskCreateStatic(rte_gen_stats_task, "stats",
        RTE_GEN_TASK_STACK_WORDS, NULL, 1, s_stack_stats, &s_tcb_stats);
    vTaskCoreAffinitySet(h_stats, RTE_GEN_CORE1_MASK);
    /* Cross-core watchdog monitor, highest app priority (BLD-007). */
    TaskHandle_t h_wdg = xTaskCreateStatic(rte_watchdog_task, "wdg",
        RTE_GEN_TASK_STACK_WORDS, (void *) &g_rte_gen_telemetry.heartbeat, 5,
        s_stack_wdg, &s_tcb_wdg);
    vTaskCoreAffinitySet(h_wdg, RTE_GEN_CORE1_MASK);

    /* Arm the fast path on the calling core (core 0). Notifications stay
     * gated until the handles publish below. */
    hardware_alarm_claim(RTE_GEN_ALARM_NUM);
    irq_set_exclusive_handler(RTE_GEN_ALARM_IRQ, rte_gen_fast_isr);
    irq_set_priority(RTE_GEN_ALARM_IRQ, 0);
    s_deadline_us = timer_hw->timerawl + RTE_GEN_PERIOD_US;
    timer_hw->alarm[RTE_GEN_ALARM_NUM] = s_deadline_us;
    hw_set_bits(&timer_hw->inte, 1u << RTE_GEN_ALARM_NUM);
    irq_set_enabled(RTE_GEN_ALARM_IRQ, true);
    rte_watchdog_init(); /* BLD-007 */

{% for group in slow_groups %}
    s_h_{{ group.name }} = h_{{ group.name }};
{% endfor %}
    __compiler_memory_barrier();
}
