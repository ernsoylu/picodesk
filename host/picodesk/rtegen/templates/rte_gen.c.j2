{% endfor %}

{% for model in fast.models %}
    {
        pd_{{ model.name }}_in_t in = {0};
        pd_{{ model.name }}_out_t out;
{% for p in model.inports %}
{% if p.source.kind != "zero" %}
        {{ cp("in." ~ p.name, src(p.source), p.width) }}
{% endif %}
{% endfor %}
        pd_{{ model.name }}_step(&in, &out);
{% for p in model.outports %}
        {{ cp("s_store_fast_1ms." ~ model.name ~ "_" ~ p.name, "out." ~ p.name, p.width) }}
{% endfor %}
    }
{% endfor %}

{% for w in fast.hal_writes %}
    {{ w.func }}({{ w.arg }}, s_store_fast_1ms.{{ w.model }}_{{ w.port }});
{% endfor %}

    /* Publish outbound buses (RTE-004). */
{% for bus in buses if bus.src == "fast_1ms" %}
    {
        rte_gen_{{ bus.name }}_t tmp;
{% for f in bus.fields %}
        {{ cp("tmp." ~ f.field, "s_store_fast_1ms." ~ f.model ~ "_" ~ f.port, f.width) }}
{% endfor %}
{% if bus.pad %}
        memset(tmp._pad, 0, sizeof tmp._pad);  /* padding is published too */
{% endif %}
        rte_seqlock_write(&s_sl_{{ bus.name }}, &s_bus_{{ bus.name }}, &tmp, sizeof tmp);
    }
{% endfor %}

    /* Coherent DAQ snapshot (RTE-005). */
    {
        rte_gen_daq_frame_t frame;
        frame.tick = g_rte_gen_telemetry.fast_ticks;
{% for f in daq_fields %}
        {{ cp("frame." ~ f.model ~ "_" ~ f.port, "s_store_fast_1ms." ~ f.model ~ "_" ~ f.port, f.width) }}
{% endfor %}
        if (rte_daq_ring_push(&s_daq, &frame)) {
            g_rte_gen_telemetry.daq_frames_pushed++;
        }
    }

    g_rte_gen_telemetry.heartbeat++;
    g_rte_gen_telemetry.fast_ticks++;

    BaseType_t woken = pdFALSE;
{% for group in slow_groups %}
    if (s_h_{{ group.name }} != NULL && ++s_div_{{ group.name }} >= {{ dividers[group.name] }}u) {
        s_div_{{ group.name }} = 0;
        vTaskNotifyGiveFromISR(s_h_{{ group.name }}, &woken);
    }
{% endfor %}

    const uint32_t exec = timer_hw->timerawl - t_entry;
    g_rte_gen_telemetry.exec_last_us = exec;
    if (exec > g_rte_gen_telemetry.exec_max_us) {
        g_rte_gen_telemetry.exec_max_us = exec;
    }
    if (exec > RTE_GEN_PERIOD_US) {
        g_rte_gen_telemetry.overrun_count++;
        gpio_xor_mask(1u << RTE_GEN_PIN_OVERRUN);
    }

    gpio_put(RTE_GEN_PIN_ISR_ACTIVE, 0);
    portYIELD_FROM_ISR(woken);
}

