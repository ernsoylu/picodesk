void rte_gen_init(void) {
    /* NOLOAD banks carry random power-on data: zero them so every routed
     * signal boots from zero/producer defaults (RTE-004). */
    memset(&__core0_bss_start__, 0,
           (size_t) ((uintptr_t) &__core0_bss_end__ - (uintptr_t) &__core0_bss_start__));
    memset(&__core1_bss_start__, 0,
           (size_t) ((uintptr_t) &__core1_bss_end__ - (uintptr_t) &__core1_bss_start__));
    memset(&__rte_shared_start__, 0,
           (size_t) ((uintptr_t) &__rte_shared_end__ - (uintptr_t) &__rte_shared_start__));

    rte_daq_ring_init(&s_daq, s_daq_buf, sizeof s_daq_buf,
                      sizeof(rte_gen_daq_frame_t));

{% for group in groups %}
{% for model in group.models %}
    pd_{{ model.name }}_init();
{% endfor %}
{% endfor %}

    gpio_init(RTE_GEN_PIN_ISR_ACTIVE);
    gpio_set_dir(RTE_GEN_PIN_ISR_ACTIVE, GPIO_OUT);
    gpio_init(RTE_GEN_PIN_OVERRUN);
    gpio_set_dir(RTE_GEN_PIN_OVERRUN, GPIO_OUT);
}

/* --- fast rate group: core 0 hardware timer ISR (RTE-002, BLD-001) ------- */
static void __not_in_flash_func(rte_gen_fast_isr)(void) {
    const uint32_t t_entry = timer_hw->timerawl;
    hw_clear_bits(&timer_hw->intr, 1u << RTE_GEN_ALARM_NUM);
    gpio_put(RTE_GEN_PIN_ISR_ACTIVE, 1);

    if (fault_inject_isr_wedged()) {
        /* Injected wedge (BLD-007 drill): the heartbeat stops advancing
         * while core 1 stays healthy; the monitor must catch it. */
        for (;;) {
        }
    }

    const uint32_t late = t_entry - s_deadline_us;
    if (late < 0x80000000u && late > g_rte_gen_telemetry.dispatch_jitter_max_us) {
        g_rte_gen_telemetry.dispatch_jitter_max_us = late;
    }
    uint32_t next = s_deadline_us + RTE_GEN_PERIOD_US;
    while ((int32_t) (next - timer_hw->timerawl) <= 2) {
        next += RTE_GEN_PERIOD_US;
        g_rte_gen_telemetry.overrun_count++;
        gpio_xor_mask(1u << RTE_GEN_PIN_OVERRUN);
    }
    s_deadline_us = next;
    timer_hw->alarm[RTE_GEN_ALARM_NUM] = next;

    /* Copy-in: inbound buses (RTE-001, bounded seqlock RTE-004). */
{% for bus in buses if bus.dst == "fast_1ms" %}
    if (!rte_seqlock_read(&s_sl_{{ bus.name }}, &s_shadow_{{ bus.name }},
                          &s_bus_{{ bus.name }}, sizeof s_shadow_{{ bus.name }})) {
        g_rte_gen_telemetry.seqlock_fault_count++;
