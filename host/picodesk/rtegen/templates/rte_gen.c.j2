            pd_{{ model.name }}_step(&in, &out);
{% for p in model.outports %}
            {{ cp("s_store_" ~ group.name ~ "." ~ model.name ~ "_" ~ p.name, "out." ~ p.name, p.width) }}
{% endfor %}
